    },
    {
      "id": 7,
      "title": "Prediction HTTP errors per second",
      "type": "timeseries",
      "description": "Known zero counters keep zero errors distinct from missing collection. Traffic and source-health panels qualify this measurement.",
      "gridPos": {
        "x": 0,
        "y": 38,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "((sum(rate(model_service_http_requests_total{namespace=\"$namespace\",workload=\"$workload\",method=\"POST\",route=\"/api/v1/predict\",status=~\"4..\"}[$__rate_interval])) or (0 * sum(rate(model_service_http_requests_total{namespace=\"$namespace\",workload=\"$workload\",method=\"POST\",route=\"/api/v1/predict\"}[$__rate_interval]))))) and on() (min(up{namespace=\"$namespace\",workload=\"$workload\"}) == 1)",
          "legendFormat": "4xx (client/input)",
          "range": true,
          "instant": false
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "((sum(rate(model_service_http_requests_total{namespace=\"$namespace\",workload=\"$workload\",method=\"POST\",route=\"/api/v1/predict\",status=~\"5..\"}[$__rate_interval])) or (0 * sum(rate(model_service_http_requests_total{namespace=\"$namespace\",workload=\"$workload\",method=\"POST\",route=\"/api/v1/predict\"}[$__rate_interval]))))) and on() (min(up{namespace=\"$namespace\",workload=\"$workload\"}) == 1)",
          "legendFormat": "5xx (server/operational)",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "noValue": "NO DATA",
          "min": 0,
          "color": {
