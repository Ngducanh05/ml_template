    {
      "id": 12,
      "title": "Aggregate inference P95",
      "type": "timeseries",
      "description": "Measures the prediction service call, not HTTP response serialization, network time or full request latency.",
      "gridPos": {
        "x": 0,
        "y": 78,
        "w": 24,
        "h": 8
