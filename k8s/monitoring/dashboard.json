          "sort": "desc"
        }
      }
    },
    {
      "id": 8,
      "title": "Prediction HTTP error fractions",
      "type": "timeseries",
      "description": "Empty/NaN with no traffic. No clamp or unconditional zero-fill is applied to the denominator.",
      "gridPos": {
        "x": 0,
        "y": 46,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "((sum(rate(model_service_http_requests_total{namespace=\"$namespace\",workload=\"$workload\",method=\"POST\",route=\"/api/v1/predict\",status=~\"4..\"}[$__rate_interval])) or (0 * sum(rate(model_service_http_requests_total{namespace=\"$namespace\",workload=\"$workload\",method=\"POST\",route=\"/api/v1/predict\"}[$__rate_interval])))) / sum(rate(model_service_http_requests_total{namespace=\"$namespace\",workload=\"$workload\",method=\"POST\",route=\"/api/v1/predict\"}[$__rate_interval])) and on() (sum(rate(model_service_http_requests_total{namespace=\"$namespace\",workload=\"$workload\",method=\"POST\",route=\"/api/v1/predict\"}[$__rate_interval])) > 0)) and on() (min(up{namespace=\"$namespace\",workload=\"$workload\"}) == 1)",
          "legendFormat": "4xx / all",
          "range": true,
          "instant": false
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "((sum(rate(model_service_http_requests_total{namespace=\"$namespace\",workload=\"$workload\",method=\"POST\",route=\"/api/v1/predict\",status=~\"5..\"}[$__rate_interval])) or (0 * sum(rate(model_service_http_requests_total{namespace=\"$namespace\",workload=\"$workload\",method=\"POST\",route=\"/api/v1/predict\"}[$__rate_interval])))) / sum(rate(model_service_http_requests_total{namespace=\"$namespace\",workload=\"$workload\",method=\"POST\",route=\"/api/v1/predict\"}[$__rate_interval])) and on() (sum(rate(model_service_http_requests_total{namespace=\"$namespace\",workload=\"$workload\",method=\"POST\",route=\"/api/v1/predict\"}[$__rate_interval])) > 0)) and on() (min(up{namespace=\"$namespace\",workload=\"$workload\"}) == 1)",
          "legendFormat": "5xx / all",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
