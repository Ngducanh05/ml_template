          },
          "expr": "(sum(rate(model_service_http_requests_total{namespace=\"$namespace\",workload=\"$workload\",method=\"POST\",route=\"/api/v1/predict\"}[$__rate_interval]))) and on() (min(up{namespace=\"$namespace\",workload=\"$workload\"}) == 1)",
          "legendFormat": "HTTP requests/s",
