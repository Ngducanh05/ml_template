            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 9,
      "title": "Aggregate HTTP prediction P95",
      "type": "timeseries",
      "description": "Quantile is calculated from summed histogram buckets across pods/statuses; never averaged from per-pod quantiles.",
      "gridPos": {
        "x": 0,
        "y": 54,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "(histogram_quantile(0.95, sum by (le) (rate(model_service_http_request_duration_seconds_bucket{namespace=\"$namespace\",workload=\"$workload\",method=\"POST\",route=\"/api/v1/predict\"}[$__rate_interval]))) and on() (sum(rate(model_service_http_requests_total{namespace=\"$namespace\",workload=\"$workload\",method=\"POST\",route=\"/api/v1/predict\"}[$__rate_interval])) > 0)) and on() (min(up{namespace=\"$namespace\",workload=\"$workload\"}) == 1)",
          "legendFormat": "HTTP P95",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "NO DATA",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 10,
      "title": "Inference calls per second by outcome",
      "type": "timeseries",
      "description": "One service call counts once. Outcomes: success, input_error, not_ready, error. Schema validation rejected before the service call is HTTP-only.",
      "gridPos": {
        "x": 0,
        "y": 62,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "(sum by (outcome) (rate(model_service_inference_requests_total{namespace=\"$namespace\",workload=\"$workload\"}[$__rate_interval]))) and on() (min(up{namespace=\"$namespace\",workload=\"$workload\"}) == 1)",
          "legendFormat": "{{outcome}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
