{
  "apiVersion": "v1",
  "items": [
    {
      "apiVersion": "apps/v1",
      "spec": {
        "revisionHistoryLimit": 3,
        "replicas": 1,
        "selector": {
          "matchLabels": {
            "app.kubernetes.io/name": "credit-risk-classifier-stable",
            "app.kubernetes.io/part-of": "credit-risk-serving"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app.kubernetes.io/name": "credit-risk-classifier-stable",
              "app.kubernetes.io/part-of": "credit-risk-serving"
            }
          },
          "spec": {
            "securityContext": {
              "seccompProfile": {
                "type": "RuntimeDefault"
              },
              "runAsUser": 10001,
              "runAsGroup": 10001,
              "runAsNonRoot": true
            },
            "automountServiceAccountToken": false,
            "containers": [
              {
                "image": "378457871131.dkr.ecr.ap-southeast-1.amazonaws.com/mlflow-models@sha256:45dcaf3b993483344e55f71d7486cc83ab76fd9cff8a6690318449df48d4a3a5",
                "resources": {
                  "limits": {
                    "memory": "768Mi"
                  },
                  "requests": {
                    "memory": "256Mi",
                    "cpu": "100m"
                  }
                },
                "readinessProbe": {
                  "httpGet": {
                    "path": "/health",
                    "port": "http"
                  },
                  "periodSeconds": 5
                },
                "securityContext": {
                  "capabilities": {
                    "drop": [
                      "ALL"
                    ]
                  },
                  "allowPrivilegeEscalation": false
                },
                "name": "model",
                "livenessProbe": {
                  "httpGet": {
                    "path": "/health",
                    "port": "http"
                  },
                  "periodSeconds": 15
                },
                "ports": [
                  {
                    "name": "http",
                    "containerPort": 8080
                  }
                ],
                "imagePullPolicy": "Always",
                "startupProbe": {
                  "periodSeconds": 5,
                  "httpGet": {
                    "path": "/health",
                    "port": "http"
                  },
                  "failureThreshold": 36
                }
              }
            ]
          }
        },
        "strategy": {
          "type": "RollingUpdate",
          "rollingUpdate": {
            "maxUnavailable": 0,
            "maxSurge": 1
          }
        }
      },
      "kind": "Deployment",
      "metadata": {
        "name": "credit-risk-classifier-stable",
        "namespace": "production"
      }
    },
    {
